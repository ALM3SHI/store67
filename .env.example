# ─────────────────────────────────────────────────────────────
# STORE 76 — environment variables (copy to .env.local for development)
# Never commit real values. Secrets live only on the server.
# ─────────────────────────────────────────────────────────────

# development | staging | production
#   production: indexing ON, test gateway OFF, unverified specs hidden,
#   DATABASE_URL + SESSION_SECRET required.
APP_ENV=development
# Public URL of the store, no trailing slash (https in production)
APP_URL=http://localhost:3000

# 32+ random characters (e.g. `openssl rand -base64 48`). Signs order links.
SESSION_SECRET=

# ── Database ─────────────────────────────────────────────────
# PostgreSQL connection string (Supabase: Project Settings → Database → Connection string, "Session pooler").
# Leave empty in development to use the embedded PGlite database in ~/.store76/pglite
DATABASE_URL=
# DATABASE_SSL=disable          # only for a local Postgres without TLS
# DATABASE_POOL_MAX=5
# PGLITE_DIR=~/.store76/pglite   (keep it outside the project folder)

# ── Branding (optional; defaults in src/config/brand.ts) ─────
# NEXT_PUBLIC_STORE_NAME="STORE 67"
# NEXT_PUBLIC_STORE_MARK=67
# NEXT_PUBLIC_STORE_NAME_AR="ستور 67"
# NEXT_PUBLIC_ORDER_PREFIX=S67

# ── Payments: Moyasar (https://moyasar.com) ──────────────────
# Test keys start with sk_test_ / pk_test_, live keys with sk_live_ / pk_live_.
MOYASAR_SECRET_KEY=
MOYASAR_PUBLISHABLE_KEY=
# The "Secret Token" you set on the webhook in the Moyasar dashboard.
# Webhook URL: {APP_URL}/api/payments/moyasar/webhook
MOYASAR_WEBHOOK_SECRET=
# MOYASAR_API_BASE=https://api.moyasar.com/v1

# Developer test gateway (simulated payments). Ignored when APP_ENV=production.
PAYMENTS_TEST_GATEWAY=enabled

# ── Shipping: Aramex ─────────────────────────────────────────
# From your Aramex account manager / developer portal. Leave empty for manual shipping.
ARAMEX_USERNAME=
ARAMEX_PASSWORD=
ARAMEX_ACCOUNT_NUMBER=
ARAMEX_ACCOUNT_PIN=
ARAMEX_ACCOUNT_ENTITY=
ARAMEX_ACCOUNT_COUNTRY_CODE=SA
# Production: https://ws.aramex.net/ShippingAPI.V2  — use the sandbox host Aramex gives you for testing
ARAMEX_BASE_URL=https://ws.aramex.net/ShippingAPI.V2
# ARAMEX_API_VERSION=v1.0
# ARAMEX_SOURCE=24

# ── File storage ─────────────────────────────────────────────
# local    = ./storage on disk (development, or a server with a persistent disk)
# supabase = Supabase Storage (recommended on Vercel)
STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=./storage
SUPABASE_URL=
# Server-only key. Never expose it in NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLIC_BUCKET=public-media
SUPABASE_PRIVATE_BUCKET=private-docs

# ── Customer emails & team alerts ────────────────────────────
# Resend (https://resend.com). Verify your domain there first. Empty = no emails
# (in development they are printed in the server console instead).
RESEND_API_KEY=
# EMAIL_FROM="STORE 76 <orders@mail.your-domain.sa>"
EMAIL_FROM=
# EMAIL_REPLY_TO=support@your-domain.sa
# SMS to customers via Taqnyat (https://taqnyat.sa). Each SMS costs money: also switch it
# on in Admin → Settings → Notifications. SMS_SENDER must be a sender name approved on your account.
TAQNYAT_API_KEY=
SMS_SENDER=
# Telegram bot for new-order and error alerts (see docs/DEPLOYMENT.md §10)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Scheduled jobs ───────────────────────────────────────────
# Protects /api/cron/expire-orders (Vercel Cron sends it automatically as a Bearer token)
CRON_SECRET=

# ── Optional AI: support assistant + product copywriter ──────
# Without a key, the help widget answers from the store's FAQ only (order status still works).
# Google Gemini — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash   (gemini-3.7-flash also works; Google routes it to 3.8)
# Or Anthropic Claude instead:
ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-haiku-5-5
# AI_PROVIDER=gemini              (only needed if both keys are set)
# ASSISTANT_DAILY_LIMIT=300

# ── Development only ─────────────────────────────────────────
# Extra hostnames allowed to open `npm run dev` (home-network IPs are already allowed)
# DEV_ALLOWED_ORIGINS=my-laptop.local

# ── Admin bootstrap (used only by `npm run admin:create`) ────
# ADMIN_PASSWORD=
